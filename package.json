{
  "name": "seungsikhong.github.io",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node ./scripts/clean-dist.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "blog:new": "node ./scripts/new-post.mjs",
    "blog:meta": "node ./scripts/list-post-meta.mjs",
    "blog:category:add": "node ./scripts/add-post-meta.mjs category",
    "blog:tag:add": "node ./scripts/add-post-meta.mjs tag",
    "blog:collection:add": "node ./scripts/add-post-meta.mjs collection",
    "blog:image": "node ./scripts/add-image.mjs",
    "views:d1:create": "npx wrangler d1 create seungsikhong_blog_views",
    "views:d1:migrate": "npx wrangler d1 migrations apply seungsikhong_blog_views --remote --config workers/view-counter/wrangler.toml",
    "views:secret": "npx wrangler secret put VIEW_COUNTER_SALT --config workers/view-counter/wrangler.toml",
    "views:deploy": "npx wrangler deploy --config workers/view-counter/wrangler.toml",
    "new-post": "node ./scripts/new-post.mjs",
    "list-post-meta": "node ./scripts/list-post-meta.mjs",
    "add-image": "node ./scripts/add-image.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/react": "^6.0.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^6.4.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}

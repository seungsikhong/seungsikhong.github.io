{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Blog: 새 글 만들기",
      "detail": "npm run blog:new",
      "type": "shell",
      "command": "npm run blog:new -- --title \"${input:postTitle}\" --excerpt \"${input:postExcerpt}\" --category \"${input:postCategory}\" --collection \"${input:postCollection}\" --collection-order \"${input:postCollectionOrder}\" --tags \"${input:postTags}\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Blog: 카테고리/태그/컬렉션 조회",
      "detail": "npm run blog:meta",
      "type": "npm",
      "script": "blog:meta",
      "problemMatcher": []
    },
    {
      "label": "Blog: 카테고리 추가",
      "detail": "npm run blog:category:add",
      "type": "shell",
      "command": "npm run blog:category:add -- --name \"${input:categoryName}\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Blog: 태그 추가",
      "detail": "npm run blog:tag:add",
      "type": "shell",
      "command": "npm run blog:tag:add -- --name \"${input:tagName}\" --menu \"${input:tagMenu}\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Blog: 컬렉션 추가",
      "detail": "npm run blog:collection:add",
      "type": "shell",
      "command": "npm run blog:collection:add -- --name \"${input:collectionName}\" --category \"${input:collectionCategory}\" --description \"${input:collectionDescription}\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Blog: 이미지 추가",
      "detail": "npm run blog:image",
      "type": "shell",
      "command": "npm run blog:image -- --slug \"${input:imagePostSlug}\" \"${input:imagePath}\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Blog: 개발 서버 실행",
      "detail": "npm run dev",
      "type": "npm",
      "script": "dev",
      "problemMatcher": []
    },
    {
      "label": "Blog: 빌드",
      "detail": "npm run build",
      "type": "npm",
      "script": "build",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "postTitle",
      "type": "promptString",
      "description": "Post title"
    },
    {
      "id": "postExcerpt",
      "type": "promptString",
      "description": "One-sentence excerpt for lists, search results, and social previews",
      "default": ""
    },
    {
      "id": "postCategory",
      "type": "promptString",
      "description": "Category",
      "default": ""
    },
    {
      "id": "postCollection",
      "type": "promptString",
      "description": "Collection id or name. Leave empty for Other Posts.",
      "default": ""
    },
    {
      "id": "postCollectionOrder",
      "type": "promptString",
      "description": "Collection order. Leave empty to use the next number.",
      "default": ""
    },
    {
      "id": "postTags",
      "type": "promptString",
      "description": "Tags, comma-separated",
      "default": ""
    },
    {
      "id": "categoryName",
      "type": "promptString",
      "description": "Category to add"
    },
    {
      "id": "tagName",
      "type": "promptString",
      "description": "Tag to add"
    },
    {
      "id": "collectionName",
      "type": "promptString",
      "description": "Collection name"
    },
    {
      "id": "collectionCategory",
      "type": "promptString",
      "description": "Collection category",
      "default": ""
    },
    {
      "id": "collectionDescription",
      "type": "promptString",
      "description": "Collection description",
      "default": ""
    },
    {
      "id": "tagMenu",
      "type": "pickString",
      "description": "Show this tag in the navigation menu?",
      "options": [
        "false",
        "true"
      ],
      "default": "false"
    },
    {
      "id": "imagePostSlug",
      "type": "promptString",
      "description": "Post slug, for example ai/01-artificial-intelligence"
    },
    {
      "id": "imagePath",
      "type": "promptString",
      "description": "Absolute image path"
    }
  ]
}

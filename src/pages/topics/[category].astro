---
import SiteLayout from '../../layouts/SiteLayout.astro'
import { POST_CATEGORIES } from '../../content/categories'
import { buildCollectionGroups } from '../../utils/collections'
import { getPublishedPosts } from '../../utils/content'
import { formatDate } from '../../utils/date'
import { getPostHref } from '../../utils/posts'
import { buildCategoryItems, getCategorySlug } from '../../utils/taxonomy'

export async function getStaticPaths() {
  const posts = await getPublishedPosts()
  const categories = buildCategoryItems(posts, { include: POST_CATEGORIES, includeEmpty: true })

  return categories.map((category) => ({
    params: { category: getCategorySlug(category.label) },
    props: { categoryName: category.label, count: category.count, posts },
  }))
}

const { categoryName, count, posts } = Astro.props
const filteredPosts = posts
  .filter((post) => post.data.category === categoryName)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
const { groups: collectionGroups, ungroupedPosts } = buildCollectionGroups(filteredPosts, categoryName)
const hasCollectionGroups = collectionGroups.length > 0
const collectionLabel = `${collectionGroups.length} Collection${collectionGroups.length === 1 ? '' : 's'}`
const formatPostCount = (value: number) => `${value} Post${value === 1 ? '' : 's'}`
---

<SiteLayout
  title={categoryName}
  description={`${formatPostCount(count)} in ${categoryName}.`}
  robots={count > 0 ? 'index,follow,max-image-preview:large' : 'noindex,follow'}
>
  <div class="mx-auto flex w-full max-w-5xl flex-col gap-8">
    <section class="border-b border-border/70 pb-8">
      <h1 class="text-4xl font-semibold tracking-[-0.03em] text-foreground md:text-[3.1rem]">
        {categoryName}
      </h1>
      <p class="mt-6 max-w-2xl text-[1.02rem] leading-8 text-muted-foreground">
        {formatPostCount(count)}{hasCollectionGroups && ` · ${collectionLabel}`}
      </p>
    </section>

    <section>
      {
        filteredPosts.length === 0 ? (
          <div class="border border-border/70 bg-card/50 px-6 py-12">
            <h2 class="text-xl font-semibold tracking-tight text-foreground">
              No posts yet.
            </h2>
            <p class="mt-3 max-w-xl text-sm leading-7 text-muted-foreground">
              The first note in this category will be published soon.
            </p>
          </div>
        ) : hasCollectionGroups ? (
          <div class="space-y-4">
            {
              collectionGroups.map((group, groupIndex) => (
                <details
                  class="group rounded-[1.5rem] border border-border/70 bg-card/65 p-5"
                  open={groupIndex === 0}
                >
                  <summary class="flex cursor-pointer list-none flex-col gap-3 md:flex-row md:items-start md:justify-between">
                    <div>
                      <p class="text-[0.72rem] font-semibold uppercase tracking-[0.18em] text-primary">
                        Collection
                      </p>
                      <h2 class="mt-2 text-2xl font-semibold tracking-tight text-foreground">
                        {group.collection.label}
                      </h2>
                      {group.collection.description && (
                        <p class="mt-2 max-w-2xl text-sm leading-7 text-muted-foreground">
                          {group.collection.description}
                        </p>
                      )}
                    </div>
                    <span class="inline-flex w-fit items-center gap-2 rounded-full bg-muted/70 px-3 py-1 text-xs font-semibold text-muted-foreground">
                      {formatPostCount(group.posts.length)}
                      <span class="transition group-open:rotate-180" aria-hidden="true">⌄</span>
                    </span>
                  </summary>

                  <div class="mt-5 divide-y divide-border/70 border-t border-border/70 pt-2">
                    {group.posts.map((post, postIndex) => (
                      <article class="grid gap-4 rounded-xl py-4 transition hover:bg-accent/25 hover:px-4 md:grid-cols-[minmax(0,1fr)_10rem] md:items-start">
                        <div>
                          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">
                            {String(post.data.collectionOrder ?? postIndex + 1).padStart(2, '0')}
                          </p>
                          <h3 class="mt-2 text-2xl font-semibold tracking-tight text-foreground">
                            <a class="transition hover:text-primary" href={getPostHref(post)}>
                              {post.data.title}
                            </a>
                          </h3>
                          <p class="mt-3 max-w-2xl text-sm leading-7 text-muted-foreground">
                            {post.data.excerpt}
                          </p>
                        </div>

                        <div class="flex items-center justify-between gap-2 text-sm text-muted-foreground md:flex-col md:items-end md:justify-start md:pt-1">
                          <span>{formatDate(post.data.publishedAt)}</span>
                          <span
                            data-view-count-path={getPostHref(post)}
                            data-view-count-fallback="—"
                          >
                            —
                          </span>
                          <span>{post.data.comments ? 'Comments on' : 'Comments off'}</span>
                        </div>
                      </article>
                    ))}
                  </div>
                </details>
              ))
            }

            {
              ungroupedPosts.length > 0 && (
                <details class="group rounded-[1.5rem] border border-border/70 bg-card/65 p-5" open>
                  <summary class="flex cursor-pointer list-none flex-col gap-3 md:flex-row md:items-start md:justify-between">
                    <div>
                      <h2 class="text-2xl font-semibold tracking-tight text-foreground">
                        Other Posts
                      </h2>
                    </div>
                    <span class="inline-flex w-fit items-center gap-2 rounded-full bg-muted/70 px-3 py-1 text-xs font-semibold text-muted-foreground">
                      {formatPostCount(ungroupedPosts.length)}
                      <span class="transition group-open:rotate-180" aria-hidden="true">⌄</span>
                    </span>
                  </summary>

                  <div class="mt-5 divide-y divide-border/70 border-t border-border/70 pt-2">
                    {ungroupedPosts.map((post) => (
                      <article class="grid gap-4 rounded-xl py-4 transition hover:bg-accent/25 hover:px-4 md:grid-cols-[minmax(0,1fr)_10rem] md:items-start">
                        <div>
                          <h3 class="text-2xl font-semibold tracking-tight text-foreground">
                            <a class="transition hover:text-primary" href={getPostHref(post)}>
                              {post.data.title}
                            </a>
                          </h3>
                          <p class="mt-3 max-w-2xl text-sm leading-7 text-muted-foreground">
                            {post.data.excerpt}
                          </p>
                        </div>

                        <div class="flex items-center justify-between gap-2 text-sm text-muted-foreground md:flex-col md:items-end md:justify-start md:pt-1">
                          <span>{formatDate(post.data.publishedAt)}</span>
                          <span
                            data-view-count-path={getPostHref(post)}
                            data-view-count-fallback="—"
                          >
                            —
                          </span>
                          <span>{post.data.comments ? 'Comments on' : 'Comments off'}</span>
                        </div>
                      </article>
                    ))}
                  </div>
                </details>
              )
            }
          </div>
        ) : (
          <div class="divide-y divide-border/70">
            {
              filteredPosts.map((post) => (
                <article class="grid gap-4 rounded-xl py-5 transition hover:bg-accent/25 hover:px-4 md:grid-cols-[minmax(0,1fr)_10rem] md:items-start">
                  <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">
                      {post.data.category}
                    </p>
                    <h2 class="mt-2 text-2xl font-semibold tracking-tight text-foreground">
                      <a class="transition hover:text-primary" href={getPostHref(post)}>
                        {post.data.title}
                      </a>
                    </h2>
                    <p class="mt-3 max-w-2xl text-sm leading-7 text-muted-foreground">
                      {post.data.excerpt}
                    </p>
                  </div>

                  <div class="flex items-center justify-between gap-2 text-sm text-muted-foreground md:flex-col md:items-end md:justify-start md:pt-1">
                    <span>{formatDate(post.data.publishedAt)}</span>
                    <span
                      data-view-count-path={getPostHref(post)}
                      data-view-count-fallback="—"
                    >
                      —
                    </span>
                    <span>{post.data.comments ? 'Comments on' : 'Comments off'}</span>
                  </div>
                </article>
              ))
            }
          </div>
        )
      }
    </section>
  </div>
</SiteLayout>

---
import { render } from 'astro:content'
import ArticleLayout from '../../layouts/ArticleLayout.astro'
import Callout from '../../components/post/Callout.astro'
import PostImage from '../../components/post/PostImage.astro'
import { getPublishedPosts } from '../../utils/content'
import { getCollectionPostNavigation } from '../../utils/collections'
import { getPostHref, getPostSlug } from '../../utils/posts'

export async function getStaticPaths() {
  const posts = await getPublishedPosts()

  return posts.map((post) => ({
    params: { slug: getPostSlug(post) },
    props: { post },
  }))
}

const { post } = Astro.props
const posts = await getPublishedPosts()
const collectionNavigation = getCollectionPostNavigation(posts, post)
const shouldShowCollectionNavigation =
  post.data.showCollection === true ||
  (post.data.showCollection !== false && (collectionNavigation?.posts.length ?? 0) > 1)
const visibleCollectionNavigation = shouldShowCollectionNavigation ? collectionNavigation : undefined
const { Content, headings } = await render(post)
---

<ArticleLayout
  title={post.data.title}
  description={post.data.excerpt}
  category={post.data.category}
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  tags={post.data.tags}
  headings={headings}
  comments={post.data.comments}
  ogImage={post.data.ogImage}
  collectionNavigation={visibleCollectionNavigation && {
    label: visibleCollectionNavigation.collection.label,
    description: visibleCollectionNavigation.collection.description,
    currentIndex: visibleCollectionNavigation.currentIndex,
    posts: visibleCollectionNavigation.posts.map((collectionPost) => ({
      title: collectionPost.data.title,
      href: getPostHref(collectionPost),
      order: collectionPost.data.collectionOrder,
      current: collectionPost.id === post.id,
    })),
    previousPost: visibleCollectionNavigation.previousPost && {
      title: visibleCollectionNavigation.previousPost.data.title,
      href: getPostHref(visibleCollectionNavigation.previousPost),
    },
    nextPost: visibleCollectionNavigation.nextPost && {
      title: visibleCollectionNavigation.nextPost.data.title,
      href: getPostHref(visibleCollectionNavigation.nextPost),
    },
  }}
>
  <Content components={{ Callout, PostImage }} />
</ArticleLayout>
